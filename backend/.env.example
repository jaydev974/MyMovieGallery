# ─── Environment Configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ─── App ────────────────────────────────────────────────────────────────────────
APP_NAME=MyMovieGallery
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mymoviegallery:mymoviegallery@localhost:5432/mymoviegallery

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── TMDb API ───────────────────────────────────────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── OMDb API ───────────────────────────────────────────────────────────────────
OMDB_API_KEY=e56cd9cd

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@mymoviegallery.com
EMAILS_FROM_NAME=MyMovieGallery

# ─── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── ML Service ─────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
