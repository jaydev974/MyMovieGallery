# Copy this file to backend/.env for local development.
# Never commit real secrets or production values.

APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_DOCS_ENABLED=true

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_URL=postgresql+asyncpg://mymoviegallery:change-me@localhost:5432/mymoviegallery
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REQUEST_MAX_BODY_BYTES=2000000

JWT_SECRET_KEY=generate-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional server-side metadata proxy.
OMDB_API_KEY=
OMDB_TIMEOUT_SECONDS=8
