# Development Docker Compose settings. Replace every placeholder.
POSTGRES_DB=mymoviegallery
POSTGRES_USER=mymoviegallery
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://mymoviegallery:replace-with-a-local-password@db:5432/mymoviegallery
CORS_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET_KEY=replace-with-a-local-secret-at-least-32-characters
OMDB_API_KEY=replace-with-your-omdb-key
VITE_API_BASE_URL=
