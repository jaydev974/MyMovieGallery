# Copy to .env.production and replace every placeholder before deployment.
ENVIRONMENT=production
APP_VERSION=1.0.0
API_DOCS_ENABLED=false
WEB_CONCURRENCY=2

# Use hostnames without schemes in ALLOWED_HOSTS.
ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1
CORS_ORIGINS=https://example.com,https://www.example.com

POSTGRES_DB=mymoviegallery
POSTGRES_USER=mymoviegallery
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://mymoviegallery:replace-with-a-long-random-password@db:5432/mymoviegallery
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REQUEST_MAX_BODY_BYTES=2000000

JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
# Optional server-side OMDb metadata proxy. Never add this key to VITE_* variables.
OMDB_API_KEY=replace-with-your-omdb-key
